[Unit]
Description=sdn.sh control plane
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
# cp-store.env holds SDN_STORE, the database URL with its password, which
# deploy/hostprep.sh writes; cp.env holds SDN_CP_ARGS, the other flags.
EnvironmentFile=/etc/sdn/cp-store.env
EnvironmentFile=/etc/sdn/cp.env
ExecStart=/usr/local/bin/sdn-cp --store ${SDN_STORE} $SDN_CP_ARGS
Restart=always
RestartSec=1
LimitNOFILE=1048576

[Install]
WantedBy=multi-user.target
