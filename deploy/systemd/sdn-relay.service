[Unit]
Description=sdn.sh relay
After=network-online.target
Wants=network-online.target

[Service]
# relay.env holds SDN_RELAY_ARGS: the control plane's URL, the relay's
# credentials file, its state directory, probe address and telemetry
# address. The port table and registration secrets persist in the state
# directory, so a restart during a control-plane outage strands nothing.
EnvironmentFile=/etc/sdn/relay.env
ExecStart=/usr/local/bin/sdn-relay $SDN_RELAY_ARGS
Restart=always
RestartSec=1
# A socket per directed port.
LimitNOFILE=1048576

[Install]
WantedBy=multi-user.target
