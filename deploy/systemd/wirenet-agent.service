[Unit]
Description=wirenet host agent
After=network-online.target
Wants=network-online.target

[Service]
# agent.env holds WIRENET_AGENT_ARGS: the control plane's URL, the host's
# credentials file and the telemetry address.
EnvironmentFile=/etc/wirenet/agent.env
ExecStart=/usr/local/bin/wirenet-agent $WIRENET_AGENT_ARGS
# The kernel keeps the data plane when the agent stops, so a restart
# costs no traffic. The descriptor store hands the stub resolver's
# listening sockets to the next process, so queries wait in their buffers
# across the restart instead of failing.
Restart=always
RestartSec=300ms
NotifyAccess=main
# Two descriptors per namespace, UDP and TCP, plus two per extra resolver
# address: enough for every listen port a host can hand out.
FileDescriptorStoreMax=65536
FileDescriptorStorePreserve=yes
# One netlink socket per workload namespace, and devices by the thousand.
LimitNOFILE=1048576

[Install]
WantedBy=multi-user.target
