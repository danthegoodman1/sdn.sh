#!/usr/bin/env bash
# Builds the daemons and the end-to-end tests as you, then runs the tests as
# root, since the lab creates namespaces and devices.
#
#   scripts/e2e [test binary flags...]   e.g. scripts/e2e -test.run TwoHosts -test.v
#
# WIRENET_TEST_POSTGRES, when set, runs the control plane on Postgres.
set -euo pipefail
cd "$(dirname "$0")/.."
work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT
go build -o "$work/bin/" ./cmd/wirenet-cp ./cmd/wirenet-agent ./cmd/wirenet-relay ./cmd/wirenetctl
go test -c -o "$work/e2e.test" ./e2e
cd e2e
sudo env WIRENET_LAB_BIN="$work/bin" WIRENET_TEST_POSTGRES="${WIRENET_TEST_POSTGRES:-}" WIRENET_LAB_KEEP="${WIRENET_LAB_KEEP:-}" WIRENET_LAB_KEEP_ALWAYS="${WIRENET_LAB_KEEP_ALWAYS:-}" \
	"$work/e2e.test" -test.timeout 20m "$@"
