#!/usr/bin/env bash
# Builds the daemons and the end-to-end tests as you, then runs the tests as
# root, since the lab creates namespaces and devices.
#
#   scripts/e2e [test binary flags...]   e.g. scripts/e2e -test.run TwoHosts -test.v
#
# SDN_TEST_POSTGRES, when set, runs the control plane on Postgres.
set -euo pipefail
cd "$(dirname "$0")/.."
work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT
go build -o "$work/bin/" ./cmd/sdn-cp ./cmd/sdn-agent ./cmd/sdn-relay ./cmd/sdnctl
go test -c -o "$work/e2e.test" ./e2e
cd e2e
sudo env SDN_LAB_BIN="$work/bin" SDN_TEST_POSTGRES="${SDN_TEST_POSTGRES:-}" SDN_LAB_KEEP="${SDN_LAB_KEEP:-}" \
	"$work/e2e.test" -test.timeout 20m "$@"
