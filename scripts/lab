#!/usr/bin/env bash
# Builds the daemons, wirenet-bench, hostbench and wirenet-lab as you, then runs
# wirenet-lab as root, since the local environment creates namespaces and
# devices. Reports land in reports/ under the repository.
#
#   scripts/lab run --plan paths --duration 3s
#   scripts/lab run --plan all --store postgres://user:pass@127.0.0.1:5432/db
set -euo pipefail
cd "$(dirname "$0")/.."
work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT
go build -o "$work/" ./cmd/wirenet-cp ./cmd/wirenet-agent ./cmd/wirenet-relay ./cmd/wirenetctl ./cmd/wirenet-bench ./cmd/hostbench ./cmd/wirenet-lab
cmd=${1:-}
shift || true
sudo "$work/wirenet-lab" "$cmd" --bin "$work" "$@"
