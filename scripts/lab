#!/usr/bin/env bash
# Builds the daemons, sdn-bench, hostbench and sdn-lab as you, then runs
# sdn-lab as root, since the local environment creates namespaces and
# devices. Reports land in reports/ under the repository.
#
#   scripts/lab run --plan paths --duration 3s
#   scripts/lab run --plan all --store postgres://user:pass@127.0.0.1:5432/db
set -euo pipefail
cd "$(dirname "$0")/.."
work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT
go build -o "$work/" ./cmd/sdn-cp ./cmd/sdn-agent ./cmd/sdn-relay ./cmd/sdnctl ./cmd/sdn-bench ./cmd/hostbench ./cmd/sdn-lab
cmd=${1:-}
shift || true
sudo "$work/sdn-lab" "$cmd" --bin "$work" "$@"
